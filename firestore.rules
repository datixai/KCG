rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only this Firebase Auth account can edit content from the admin panel.
    // Firebase allows one account per email, and public sign-up should be turned off
    // (Authentication > Settings > User actions > uncheck "Enable create (sign-up)").
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'datixai.com@gmail.com';
    }

    // ── Public read, admin write ──
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Photos uploaded from the admin panel (stored as data URLs, served at /img/<id>) ──
    match /images/{docId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow delete: if isAdmin();
    }

    // ── Contact form: anyone can create a validated message, only admin can read ──
    match /messages/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'phone', 'message', 'read', 'createdAt'])
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() < 40
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }
  }
}
